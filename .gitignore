# Repository-wide ignores. Backend/ and Frontend/ each keep their own
# .gitignore for rules specific to that stack; this file covers the whole tree
# and, deliberately, everything that must never be committed regardless of
# which directory it turns up in.

# --- secrets and local configuration -------------------------------------
# .env carries the Django secret key and the Django<->intelligence service
# token. .env.example is the file that belongs in the repository.
.env
.env.*
!.env.example
*.pem
*.key
!**/lib/**/*.key

# --- data ----------------------------------------------------------------
# The dev database holds real-shaped patient records; the NHANES cache is
# 58 MB of public data that any checkout can re-download in one command.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
Backend/media/
Backend/intelligence/_data/
Backend/intelligence/_artifacts/

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- node ----------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- editors and operating systems ---------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- scratch -------------------------------------------------------------
*.bak
*.orig
*.rej
.cache/
.local/
