# CareSense AI backend - example environment.
# Copy to .env for local development. NEVER commit real secrets.
# Credentials are read from the environment only (see section 40 of the spec).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Cross-origin access for the browser client (spec section 3) ---
# The SPA lives on its own origin and calls this API with a bearer token; the
# allowlist is exact-origin and credential-less (apps/common/cors.py). List
# every origin the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Primary database (MySQL 8.x) ---
# The application account MUST be least-privilege (no DDL/admin in prod).
MYSQL_DATABASE=caresense
MYSQL_USER=caresense_app
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Enforce TLS to the database where the server supports it.
MYSQL_SSL_CA=

# For local development without a MySQL server you may set:
# DJANGO_DB_BACKEND=sqlite

# --- Report file storage (untrusted uploads; see spec section 39) ---
# Default is a local filesystem store served only via the authorized endpoint.
# In production point this at a PRIVATE object store (no public ACL).
DJANGO_FILE_STORAGE=django.core.files.storage.FileSystemStorage
# Optional malware scanner: "package.module:function" that raises on a bad file.
REPORT_UPLOAD_SCANNER=

# --- Identity (OAuth 2.0 / OpenID Connect compatible) ---
# In real deployments tokens are minted by an external IdP; these describe how
# Django validates them. The local dev token issuer is enabled only when DEBUG.
OIDC_ISSUER=https://issuer.example.com
OIDC_AUDIENCE=caresense-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
LOCAL_DEV_TOKENS=true

# --- Django <-> FastAPI intelligence service boundary ---
# Django is the ONLY caller of the intelligence service.
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:9001
# Required on BOTH processes and they must match. Generate one per
# deployment, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Neither process will serve or call without it - a blank value is refused
# rather than treated as "no authentication needed".
INTELLIGENCE_SERVICE_TOKEN=
INTELLIGENCE_SERVICE_TIMEOUT_SECONDS=30

# --- Observability (OpenTelemetry, optional) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=caresense-django
OTEL_EXPORTER_OTLP_ENDPOINT=
