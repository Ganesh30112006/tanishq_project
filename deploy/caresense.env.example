# Copy to /etc/caresense/caresense.env on the server and fill in every value:
#   sudo install -m 640 -o root -g caresense deploy/caresense.env.example /etc/caresense/caresense.env
# One KEY=value per line, no quotes. Read by the systemd services and deploy.sh.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Public address (Caddy gets the HTTPS certificate for it) ---
CARESENSE_DOMAIN=app.example.in

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.example.in
CORS_ALLOWED_ORIGINS=https://app.example.in
FRONTEND_BASE_URL=https://app.example.in
# Caddy is the one proxy in front of Django.
DJANGO_TRUSTED_PROXY_COUNT=1
PASSWORD_SIGN_IN=true

# --- Database (MySQL on this server) ---
DJANGO_DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=caresense
MYSQL_USER=caresense_app
MYSQL_PASSWORD=

# --- Intelligence service (the same token is read by both processes) ---
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:9001
INTELLIGENCE_SERVICE_TOKEN=

# --- Virus scanning of uploads (required in production) ---
REPORT_UPLOAD_SCANNER=apps.reports.clamav:scan
# Ubuntu's clamav-daemon listens on this socket out of the box.
CLAMD_SOCKET=/var/run/clamav/clamd.ctl

# --- Email, for password reset (any SMTP provider) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CareSense <no-reply@app.example.in>

# --- Frontend build. Baked into the app at build time; the build refuses to
#     run while any of these is empty. ---
VITE_API_BASE_URL=https://app.example.in
VITE_POLICY_ORGANISATION=
VITE_POLICY_CONTACT_EMAIL=
VITE_POLICY_GRIEVANCE_OFFICER=
VITE_POLICY_DATA_LOCATION=
