# CareSense AI frontend - example environment.
# Copy to .env.local for local development.

# The Django backend's origin. Django is the only API layer this app talks to
# (clients never call the FastAPI intelligence service or a database
# directly). Cross-origin requests rely on Django's CORS allowlist
# (CORS_ALLOWED_ORIGINS in the backend's .env) matching this app's own origin.
VITE_API_BASE_URL=http://127.0.0.1:8000
